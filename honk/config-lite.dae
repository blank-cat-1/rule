# config.dae baseline + missing YAML rules only. Existing dae decisions win.
# 订阅支持V2ray/URL、mihomo等格式，多机场按照示例复制模块改机场名字即可。
subscription {
    sub: 'https://example.invalid/replace-with-your-subscription' {
        ua: 'clash.meta/1.19.30'
        interval: 0s
        cache: false
        route: direct
    }
    # sub1: '订阅链接' {
    #     ua: 'clash.meta/1.19.30'
    #     interval: 86400s
    #     cache: false
    #     route: direct
    # }
}

# node {
#     my_vps: 'hysteria2://密码@vps.example.com:443/?sni=vps.example.com'
# }

# policy 可选 select（面板手动选，默认）/ min_moving_avg（延迟最低）/ fallback（按顺序取第一个存活）/ loadbalance（轮询）/ score（按实际连接质量评分）；final：所选节点不可用时改走的组
group {
    # Auto: choose the lowest-latency healthy node from all regions.
    Auto {
        filter: !name(regex: '(?i)(官网|剩余|流量|套餐|免费|订阅|到期时间|直连|Expire Date|Traffic|ExpireDate|排除)')
        policy: min_moving_avg
        tolerance: 20
        check_url: 'https://www.gstatic.com/generate_204'
        final: block
        interrupt_connections: true
    }
    # Manual: choose Auto, one eligible node, or explicit direct.
    Manual {
        filter: group('Auto')
        filter: !name(regex: '(?i)(官网|剩余|流量|套餐|免费|订阅|到期时间|直连|Expire Date|Traffic|ExpireDate|排除)')
        filter: name(direct)
        policy: select
        default: Auto
        final: block
        interrupt_connections: true
    }
}

dns {
    ipversion_prefer: 4
    upstream {
        remote: 'https://8.8.8.8/dns-query'
        local: 'https://223.5.5.5/dns-query'
    }
    routing {
        request {
            qtype(https, svcb) -> reject
            qname(suffix: googleapis.cn, suffix: xn--ngstr-lra8j.com) -> remote
            qname(geosite: cn, geosite: microsoft@cn, geosite: apple@cn, geosite: private) -> local
            qname(geosite: geolocation-!cn) -> remote
            fallback: remote
        }
        response {
            # remote 解析出国内 IP 时改用 local 重查，拿到就近 CDN
            upstream(remote) && ip(geoip: cn) -> local
            fallback: accept
        }
    }
}

routing {
    dip(geoip: private, geoip: cn) && !dport(53, 853) -> direct(must)
    dport(853) -> block
    l4proto(udp) && dport(443) -> block
    # YAML supplement: muse
    domain(geosite: mig-muse) -> Manual
    # YAML supplement: proxy-rule
    domain(geosite: mig-proxy-rule) -> Manual
    # YAML supplement: jp-proxyrule
    domain(geosite: mig-jp-proxyrule) -> Manual
    # YAML supplement: Apple_Push
    domain(geosite: mig-apple-push) -> Manual
    dip(geoip: mig-apple-push) -> Manual
    # YAML supplement: anti-ad
    domain(geosite: mig-anti-ad) -> block
    # YAML supplement: direct
    domain(geosite: mig-direct) -> direct
    # Missing rule: private domains; reuse standard category
    domain(geosite: private) -> direct
    # YAML supplement: proxylite
    domain(geosite: mig-proxylite) -> Manual
    dip(geoip: mig-proxylite) -> Manual
    domain(suffix: googleapis.cn, suffix: xn--ngstr-lra8j.com) -> Manual
    domain(suffix: withgoogle.com, suffix: notebooklm.google, geosite: category-ai-!cn) -> Manual
    domain(geosite: youtube) -> Manual
    domain(geosite: google) -> Manual
    domain(geosite: github) -> Manual
    domain(geosite: onedrive) -> Manual
    domain(geosite: microsoft@cn) -> direct
    domain(geosite: microsoft) -> Manual
    domain(geosite: apple@cn) -> direct
    domain(geosite: apple) -> Manual
    domain(geosite: telegram) -> Manual
    domain(geosite: tiktok) -> Manual
    domain(geosite: netflix) -> Manual
    domain(geosite: paypal, geosite: binance, geosite: okx, geosite: category-cryptocurrency) -> Manual
    domain(geosite: steam@cn) -> direct
    domain(geosite: steam) -> Manual
    # YAML supplement: apple_ip
    dip(geoip: mig-apple-ip) -> direct
    # Missing rule: Google IP; reuse standard category
    dip(geoip: google) -> Manual
    # Missing rule: Netflix IP; reuse standard category
    dip(geoip: netflix) -> Manual
    domain(geosite: geolocation-!cn) -> Manual
    dip(geoip: telegram) -> Manual
    # Missing rule: China domains; reuse standard category
    domain(geosite: cn) -> direct
    # Port-53-compatible tail rule; same cn data, different conditions from initial must rule
    dip(geoip: cn) -> direct
    fallback: Manual
}

global {
    lan_interface: br-lan # DSA bridge from supplied interface listing
    wan_interface: auto
    data_dir: '/etc/honk'
    dial_mode: domain
    tls_implementation: utls
    bootstrap_resolver: '119.29.29.29:53'
    log_level: info
    check_interval: 30s
    check_tolerance: 50ms
}

assets {
    route: direct
    subscription {
        ua: 'clash.meta/1.19.30'
        interval: 0s
        cache: false
    }
    geodata {
        geosite: 'https://raw.githubusercontent.com/blank-cat-1/rule/main/honk/dat/geosite.dat'
        geoip: 'https://raw.githubusercontent.com/blank-cat-1/rule/main/honk/dat/geoip.dat'
        route: direct
    }
}

# doona 面板：http://路由器IP:9090/ui/，首次打开创建管理员
experimental {
    native_api {
        enabled: true
        listen: '0.0.0.0:9090'
        password_auth: true
        config_write: true
        ui: embedded
    }
    cache_file {
        enabled: true
        store_dns: true
    }
}
