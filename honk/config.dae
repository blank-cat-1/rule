# config.dae baseline + missing YAML rules only. Existing dae decisions win.
# 订阅支持V2ray/URL、mihomo等格式，多机场按照示例复制模块改机场名字即可。
subscription {
    sub: 'https://example.invalid/replace-with-your-subscription' {
        ua: 'clash.meta/1.19.30'
        interval: 0s
        cache: false
        route: direct
    }
    # sub1: '订阅链接' {
    #     ua: 'clash.meta/1.19.30'
    #     interval: 86400s
    #     cache: false
    #     route: direct
    # }
}

# node {
#     my_vps: 'hysteria2://密码@vps.example.com:443/?sni=vps.example.com'
# }

# policy 可选 select（面板手动选，默认）/ min_moving_avg（延迟最低）/ fallback（按顺序取第一个存活）/ loadbalance（轮询）/ score（按实际连接质量评分）；final：所选节点不可用时改走的组
group {
    Proxy {
        filter: name(regex: '🇭🇰|HK|hk|香港|港|HongKong') && !name(regex: '排除')
        final: Final
        interrupt_connections: true
    }
    AI {
        filter: name(regex: '🇺🇸|US|美国|美|United States') && !name(regex: '排除')
        final: Final
        interrupt_connections: true
    }
    YouTube {
        filter: name(regex: '🇭🇰|HK|hk|香港|港|HongKong') && !name(regex: '排除')
        final: Final
        interrupt_connections: true
    }
    Google {
        filter: name(regex: '🇭🇰|HK|hk|香港|港|HongKong') && !name(regex: '排除')
        final: Final
        interrupt_connections: true
    }
    Github {
        filter: name(regex: '🇯🇵|JP|jp|日本|日|Japan') && !name(regex: '排除')
        final: Final
        interrupt_connections: true
    }
    Telegram {
        filter: name(regex: '🇭🇰|HK|hk|香港|港|HongKong') && !name(regex: '排除')
        final: Final
        interrupt_connections: true
    }
    TikTok {
        filter: name(regex: '🇺🇸|US|美国|美|United States') && !name(regex: '排除')
        final: Final
        interrupt_connections: true
    }
    Netflix {
        filter: name(regex: '🇺🇸|US|美国|美|United States') && !name(regex: '排除')
        final: Final
        interrupt_connections: true
    }
    Wallet {
        filter: name(regex: '🇺🇸|US|美国|美|United States') && !name(regex: '排除')
        final: Final
        interrupt_connections: true
    }
    Steam {
        filter: name(regex: '🇭🇰|HK|hk|香港|港|HongKong') && !name(regex: '排除')
        final: Final
        interrupt_connections: true
    }
    Microsoft {
        filter: name(regex: '🇯🇵|JP|jp|日本|日|Japan') && !name(regex: '排除')
        final: Final
        interrupt_connections: true
    }
    OneDrive {
        filter: name(regex: '🇯🇵|JP|jp|日本|日|Japan') && !name(regex: '排除')
        final: Final
        interrupt_connections: true
    }
    Apple {
        filter: name(regex: '🇭🇰|HK|hk|香港|港|HongKong') && !name(regex: '排除')
        final: Final
        interrupt_connections: true
    }
    Final {
        filter: !name(regex: '官网|剩余|流量|套餐|免费|订阅|到期时间|直连|Expire Date|Traffic|ExpireDate')
        policy: score
    }

    # Additional region group for YAML-only custom rules
    US {
        filter: name(regex: '🇺🇸|US|美国|美|United States') && !name(regex: '排除')
        final: Final
        interrupt_connections: true
    }
    # Additional region group for YAML-only custom rules
    JP {
        filter: name(regex: '🇯🇵|JP|jp|日本|日|Japan') && !name(regex: '排除')
        final: Final
        interrupt_connections: true
    }
}

dns {
    upstream {
        remote: 'https://8.8.8.8/dns-query'
        local: 'https://223.5.5.5/dns-query'
    }
    routing {
        request {
            qtype(https, svcb) -> reject
            qtype(aaaa) -> reject
            qname(suffix: googleapis.cn, suffix: xn--ngstr-lra8j.com) -> remote
            qname(geosite: cn, geosite: microsoft@cn, geosite: apple@cn, geosite: private) -> local
            qname(geosite: geolocation-!cn) -> remote
            fallback: remote
        }
        response {
            # remote 解析出国内 IP 时改用 local 重查，拿到就近 CDN
            upstream(remote) && ip(geoip: cn) -> local
            fallback: accept
        }
    }
}

routing {
    dip(geoip: private, geoip: cn) && !dport(53, 853) -> direct(must)
    dport(853) -> block
    l4proto(udp) && dport(443) -> block
    # YAML supplement: muse
    domain(geosite: mig-muse) -> US
    # YAML supplement: proxy-rule
    domain(geosite: mig-proxy-rule) -> Proxy
    # YAML supplement: jp-proxyrule
    domain(geosite: mig-jp-proxyrule) -> JP
    # YAML supplement: Apple_Push
    domain(geosite: mig-apple-push) -> Proxy
    dip(geoip: mig-apple-push) -> Proxy
    # YAML supplement: anti-ad
    domain(geosite: mig-anti-ad) -> block
    # YAML supplement: direct
    domain(geosite: mig-direct) -> direct
    # YAML supplement: private_domain
    domain(geosite: mig-private-domain) -> direct
    # YAML supplement: proxylite
    domain(geosite: mig-proxylite) -> Proxy
    dip(geoip: mig-proxylite) -> Proxy
    domain(suffix: googleapis.cn, suffix: xn--ngstr-lra8j.com) -> Google
    domain(suffix: withgoogle.com, suffix: notebooklm.google, geosite: category-ai-!cn) -> AI
    domain(geosite: youtube) -> YouTube
    domain(geosite: google) -> Google
    domain(geosite: github) -> Github
    domain(geosite: onedrive) -> OneDrive
    domain(geosite: microsoft@cn) -> direct
    domain(geosite: microsoft) -> Microsoft
    domain(geosite: apple@cn) -> direct
    domain(geosite: apple) -> Apple
    domain(geosite: telegram) -> Telegram
    domain(geosite: tiktok) -> TikTok
    domain(geosite: netflix) -> Netflix
    domain(geosite: paypal, geosite: binance, geosite: okx, geosite: category-cryptocurrency) -> Wallet
    domain(geosite: steam@cn) -> direct
    domain(geosite: steam) -> Steam
    # YAML supplement: apple_ip
    dip(geoip: mig-apple-ip) -> direct
    # YAML supplement: google_ip
    dip(geoip: mig-google-ip) -> Google
    # YAML supplement: netflix_ip
    dip(geoip: mig-netflix-ip) -> Netflix
    domain(geosite: geolocation-!cn) -> Proxy
    dip(geoip: telegram) -> Telegram
    # YAML supplement: cn_domain
    domain(geosite: mig-cn-domain) -> direct
    # YAML supplement: cn_ip
    dip(geoip: mig-cn-ip) -> direct
    fallback: Final
}

global {
    lan_interface: br-lan # DSA bridge from supplied interface listing
    wan_interface: auto
    data_dir: '/etc/honk'
    dial_mode: domain
    tls_implementation: utls
    bootstrap_resolver: '119.29.29.29:53'
    log_level: info
    check_interval: 30s
    check_tolerance: 50ms
}

assets {
    route: direct
    subscription {
        ua: 'clash.meta/1.19.30'
        interval: 0s
        cache: false
    }
    geodata {
        geosite: 'https://raw.githubusercontent.com/blank-cat-1/rule/main/honk/dat/geosite.dat'
        geoip: 'https://raw.githubusercontent.com/blank-cat-1/rule/main/honk/dat/geoip.dat'
        route: direct
    }
}

# doona 面板：http://路由器IP:9090/ui/，首次打开创建管理员
experimental {
    native_api {
        enabled: true
        listen: '0.0.0.0:9090'
        password_auth: true
        config_write: true
        ui: embedded
    }
    cache_file {
        enabled: true
        store_dns: true
    }
}
