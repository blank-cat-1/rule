# config.dae baseline + missing YAML rules only. Existing dae decisions win.
# 订阅支持V2ray/URL、mihomo等格式，多机场按照示例复制模块改机场名字即可。
subscription {
    sub: 'https://example.invalid/replace-with-your-subscription' {
        ua: 'clash.meta/1.19.30'
        interval: 0s
        cache: false
        route: direct
    }
    # sub1: '订阅链接' {
    #     ua: 'clash.meta/1.19.30'
    #     interval: 86400s
    #     cache: false
    #     route: direct
    # }
}

# node {
#     my_vps: 'hysteria2://密码@vps.example.com:443/?sni=vps.example.com'
# }

# policy 可选 select（面板手动选，默认）/ min_moving_avg（延迟最低）/ fallback（按顺序取第一个存活）/ loadbalance（轮询）/ score（按实际连接质量评分）；final：所选节点不可用时改走的组
group {
    # Service selector
    Proxy {
        filter: group('HK-Auto')
        filter: group('HK')
        filter: group('HK-LoadBalance')
        filter: group('HK-Fallback')
        filter: group('JP-Auto')
        filter: group('JP')
        filter: group('JP-LoadBalance')
        filter: group('JP-Fallback')
        filter: group('US-Auto')
        filter: group('US')
        filter: group('US-LoadBalance')
        filter: group('US-Fallback')
        filter: group('SG-Auto')
        filter: group('SG')
        filter: group('SG-LoadBalance')
        filter: group('SG-Fallback')
        filter: group('Auto')
        filter: group('LoadBalance')
        filter: group('Other')
        filter: group('All')
        filter: name(direct)
        policy: select
        default: HK-Auto
        final: block
        interrupt_connections: true
    }
